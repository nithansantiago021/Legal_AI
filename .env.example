# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "groq", "ollama", or "huggingface"
LLM_PROVIDER=groq

# Groq (recommended: free tier, fast inference)
# Get your key from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=mixtral-8x7b-32768
LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Ollama (local models) ──────────────────────────────────────────────────────
# Uncomment below and comment Groq above to use a local Ollama model
# LLM_PROVIDER=ollama
# LLM_MODEL=mistral:7b-instruct
# LLM_BASE_URL=http://localhost:11434/v1
# GROQ_API_KEY=ollama  # Ollama ignores the key value

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
